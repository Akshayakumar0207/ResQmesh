# ResQMesh Backend — environment variables
# Copy to .env for local dev. On Render/AWS, set these in the platform's
# environment variable settings instead of committing a .env file.

# ── Database ────────────────────────────────────────────────────────────
# Leave unset to use local SQLite (zero config, works immediately).
# Set to your Supabase connection string to use Postgres instead:
#   postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
# Find this under Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> "URI" (use the "Session pooler" / "Transaction
# pooler" host on the free tier, and add +psycopg2 after "postgresql").
DATABASE_URL=sqlite:///./resqmesh.db

# ── App ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEMO_MODE=true
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# ── Auth (JWT) ──────────────────────────────────────────────────────────
# REQUIRED in any real deployment — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Google Sign-In (optional) ──────────────────────────────────────────
# Create a free OAuth 2.0 Client ID (Web application type) at
# https://console.cloud.google.com/apis/credentials — no billing required.
# Add your frontend URL(s) under "Authorized JavaScript origins".
# Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# ── Password reset email (optional) ────────────────────────────────────
# Uses plain SMTP — no paid email API. A free Gmail "app password" works:
# https://myaccount.google.com/apppasswords (requires 2FA enabled on the
# Google account). If left blank, forgot-password returns the reset link
# directly in the API response when DEMO_MODE=true, so the flow stays
# fully testable without any email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@resqmesh.local
