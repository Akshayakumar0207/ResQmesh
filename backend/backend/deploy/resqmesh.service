[Unit]
Description=ResQMesh FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/resqmesh/backend
EnvironmentFile=/home/ubuntu/resqmesh/backend/.env
ExecStart=/home/ubuntu/resqmesh/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
