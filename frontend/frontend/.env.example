# ResQMesh Frontend — environment variables
# Copy this file to .env and fill in values as needed.
# The app runs fully standalone (demo mode) with NONE of these set.

# Base URL of the FastAPI backend (Phase: backend integration).
# Leave unset to run entirely on local demo data.
VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In Client ID (Web application type) — same value as the
# backend's GOOGLE_CLIENT_ID. Create one free at
# https://console.cloud.google.com/apis/credentials
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Supabase project (only needed once the backend is wired to Supabase;
# the frontend itself never talks to Supabase directly in this architecture).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public OSRM routing server override (defaults to the public
# demo server — router.project-osrm.org — which is rate-limited but free).
VITE_OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# Optional: CARTO Basemaps API key for the dark-themed map tiles on the
# map views. Free, no approval queue, in your inbox in ~1 minute:
# https://carto.com/basemaps/apikey/
# Leave blank and the map still works — it falls back to free OpenStreetMap
# tiles with a CSS dark-mode filter instead of CARTO's styled dark tiles.
VITE_CARTO_API_KEY=
